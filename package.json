{
  "name": "@atomic-reactor/sync-state",
  "version": "1.0.2",
  "description": "A shared, path-addressable state object that dispatches events on every change. Works in browsers, React Native and Node.",
  "author": "camdagr8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReactiumCore/SyncState.git"
  },
  "bugs": {
    "url": "https://github.com/ReactiumCore/SyncState/issues"
  },
  "homepage": "https://github.com/ReactiumCore/SyncState#readme",
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "keywords": [
    "state",
    "state-management",
    "store",
    "events",
    "object-path",
    "react-native",
    "browser"
  ],
  "dependencies": {
    "@atomic-reactor/event-handle": "^1.0.2",
    "object-path": "^0.11.8",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/object-path": "^0.11.4",
    "@types/underscore": "^1.13.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
